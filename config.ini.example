[oracle]
user=USUARIO_ATLAS
password=CAMBIAR_CLAVE
dsn=SERVIDOR_ORACLE:1521/SERVICIO
pool_min=1
pool_max=8
pool_increment=1
thick_mode=true
client_lib_dir=C:\oracle\instantclient

[ldap]
enabled=true
servers=dc1.ejemplo.local,dc2.ejemplo.local
port=636
use_ssl=true
start_tls=false
validate_certificate=true
ca_cert_file=C:\certificados\ca-corporativa.pem
authentication=SIMPLE
login_format=UPN
domain_suffix=ejemplo.local
netbios_domain=EJEMPLO
connect_timeout=5
receive_timeout=8
tls_ciphers=DEFAULT
# Solo contingencia temporal formalmente autorizada.
allow_legacy_ciphers=false

[flask]
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
secret_key=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
port=5050
session_cookie_secure=true
# Permite aislar sesiones cuando existe un piloto en el mismo host con otro puerto.
session_cookie_name=session

[security]
# ATLAS debe estar detrás de HTTPS. Activar después de configurar el proxy TLS.
force_https=true
# Habilitar solo si ATLAS recibe tráfico exclusivamente desde un proxy confiable.
trust_proxy_headers=true
trusted_proxy_hops=1
session_idle_minutes=30
session_absolute_minutes=720
session_validation_seconds=120
max_failed_logins=5
max_failed_logins_ip=20
login_rate_window_minutes=15
login_lock_minutes=15
hsts_seconds=31536000
session_cookie_samesite=Lax
content_security_policy=default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

[features]
# Modulo v0.4: desplegar inicialmente apagado y habilitar solo en piloto.
knowledge_enabled=false

[knowledge]
# Ruta fuera del arbol de codigo y no servida directamente por el web server.
storage_path=K:\@@@@@ATLAS_DATA\conocimiento
max_file_mb=25
allowed_extensions=pdf,docx,xlsx,pptx,txt,csv,png,jpg,jpeg
# Mientras no exista scanner corporativo configurado, las cargas de archivos deben quedar bloqueadas.
antivirus_required=true
# Comando corporativo futuro. Debe devolver codigo 0 cuando el archivo este limpio.
antivirus_command=
